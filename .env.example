# Local SQLite or Supabase PostgreSQL connection string.
DATABASE_URL=sqlite:////data/healthtech.db
UPLOAD_DIR=/app/uploads
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
CORS_ORIGIN_REGEX=
NEXT_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
EXPO_PUBLIC_API_TIMEOUT_MS=20000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Demo authentication and destructive reset are disabled when false.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_DEMO_MODE=true

# Optional live AI provider. Keep secrets server-side.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Required for production CV ingestion.
CV_SERVICE_TOKEN=
CV_HOSPITAL_ID=hospital_caspian
CV_BACKEND_URL=http://localhost:8000
CV_MODEL=yolo11n-pose.pt
CV_VIDEO_PATH=./videos/fall_risk_demo.mp4
DEMO_ROOM_ID=204
