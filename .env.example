# Local database; leave empty to use backend/healthtech.db.
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Demo authentication and destructive reset are disabled when false.
DEMO_MODE=true
APP_ENV=development

# Optional live AI provider. Keep secrets server-side.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Optional Supabase migration targets (not required by the local SQLite demo).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# Required for production CV ingestion.
CV_SERVICE_TOKEN=
CV_HOSPITAL_ID=hospital_caspian
CV_BACKEND_URL=http://localhost:8000
DEMO_ROOM_ID=204
