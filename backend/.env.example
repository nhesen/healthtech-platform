# Local: sqlite:///./backend/healthtech.db
# Supabase: use the PostgreSQL pooler/session connection string with sslmode=require.
DATABASE_URL=sqlite:///./backend/healthtech.db
UPLOAD_DIR=./backend/uploads
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional anchored regex for trusted preview domains only.
CORS_ORIGIN_REGEX=

# Server-side AI configuration. Never expose these values to Expo or NEXT_PUBLIC_*.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Shared secret used only by the backend and local CV sender.
CV_SERVICE_TOKEN=
CV_HOSPITAL_ID=hospital_caspian
