{
  "expo": {
    "name": "DigiSolution",
    "slug": "digisolution-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "digisolution",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "az.digisolution.patient"
    },
    "android": {
      "package": "az.digisolution.patient",
      "adaptiveIcon": {
        "backgroundColor": "#E6F0FF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DigiSolution to select a medical document image.",
          "cameraPermission": "Allow DigiSolution to photograph a medical document.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
